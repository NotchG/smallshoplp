  "reviews": [
    {
      "name": "places/ChIJj7x9wQGLaS4Rai6OpBSAXQ8/reviews/ChZDSUhNMG9nS0VJQ0FnSURlaXRhbGNBEAE",
      "relativePublishTimeDescription": "4 years ago",
      "rating": 4,
      "text": {
        "text": "A very cute cafe with a nice ambience. Not too big, cozy enough. Interesting menu as well.\n\nI ordered:\nOmelette breakfast 7/10 - Could've added more salt, egg not fluffy, sausage and bacon a bit too oily\nTiramisu 9/10 - Balanced flavor and cute presentation\nHP Potion 8/10 - unique and refreshing but the peach tastes a bit too artificial\n\nWould love to go back again but not for working/having a meeting. The music is too loud and distracting.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "A very cute cafe with a nice ambience. Not too big, cozy enough. Interesting menu as well.\n\nI ordered:\nOmelette breakfast 7/10 - Could've added more salt, egg not fluffy, sausage and bacon a bit too oily\nTiramisu 9/10 - Balanced flavor and cute presentation\nHP Potion 8/10 - unique and refreshing but the peach tastes a bit too artificial\n\nWould love to go back again but not for working/having a meeting. The music is too loud and distracting.",
        "languageCode": "en"
      },
