  "reviews": [
    {
      "name": "places/ChIJPScisMnzaS4RZRHXudFUW_k/reviews/Ci9DQUlRQUNvZENodHljRjlvT2pnd1RFeHVUa2c1VUhabmNVWmpTRGhRVkRaSVVsRRAB",
      "relativePublishTimeDescription": "5 months ago",
      "rating": 5,
      "text": {
        "text": "Kanal Feds instantly left a good impression from the moment I stepped in. The café has a very well-thought-out concept — the indoor space is pleasantly cool and comfortable, while the outdoor area feels equally inviting, especially the second floor which has a beautiful ambiance.\n\nThe drinks and light meals were enjoyable, and its location right beside a gym makes it a great option for a post-workout hangout.\n\nWhat made the experience even better was the hospitality. The staff were genuinely warm and welcoming from the start, making the atmosphere feel very friendly and comfortable.\n\nA little tip: come dressed nicely because the crowd here is effortlessly stylish, and the café has several aesthetically pleasing photo spots. Definitely a place worth revisiting.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "Kanal Feds instantly left a good impression from the moment I stepped in. The café has a very well-thought-out concept — the indoor space is pleasantly cool and comfortable, while the outdoor area feels equally inviting, especially the second floor which has a beautiful ambiance.\n\nThe drinks and light meals were enjoyable, and its location right beside a gym makes it a great option for a post-workout hangout.\n\nWhat made the experience even better was the hospitality. The staff were genuinely warm and welcoming from the start, making the atmosphere feel very friendly and comfortable.\n\nA little tip: come dressed nicely because the crowd here is effortlessly stylish, and the café has several aesthetically pleasing photo spots. Definitely a place worth revisiting.",
        "languageCode": "en"
      },
