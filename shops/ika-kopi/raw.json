  "reviews": [
    {
      "name": "places/ChIJ-zHHdADtaS4RS96eUvnXOJM/reviews/Ci9DQUlRQUNvZENodHljRjlvT25NM01qY3hkV2hOYjNwWlRUTmZUMk5ITm5obk1XYxAB",
      "relativePublishTimeDescription": "3 months ago",
      "rating": 5,
      "text": {
        "text": "Highly recommended if you need a comfortable, cold place to work in Ciracas! The air conditioning works very well, the prices are reasonable, and the spacious layout means tables aren't packed together. Every table has its own plug, the chairs are cushioned, and the tables are big enough for your laptop and food. The toilet is also super clean (though there’s only one). The menu is a bit limited right now—hopefully, they add more main courses and drinks soon. Parking is great for motorcycles, but tight for cars.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "Highly recommended if you need a comfortable, cold place to work in Ciracas! The air conditioning works very well, the prices are reasonable, and the spacious layout means tables aren't packed together. Every table has its own plug, the chairs are cushioned, and the tables are big enough for your laptop and food. The toilet is also super clean (though there’s only one). The menu is a bit limited right now—hopefully, they add more main courses and drinks soon. Parking is great for motorcycles, but tight for cars.",
        "languageCode": "en"
      },
