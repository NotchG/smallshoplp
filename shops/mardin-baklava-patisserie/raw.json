    {
      "name": "places/ChIJK3xb0mDzaS4RyQOmsFcW-_M/reviews/ChdDSUhNMG9nS0VJQ0FnSURzMnBQYW1nRRAB",
      "relativePublishTimeDescription": "6 years ago",
      "rating": 4,
      "text": {
        "text": "The food is so turkish! For the indonesians Turkish pastry might be overwhelmingly sweet, but for those who love sweet dessert, this place is a heaven. All the pastries are recommended, my most favorite one was pistachio classic baklava. If you love desert that has savoury ingredients, kunafe is a must. I also ordered the saffron ice cream but it turned out very weird, not recommended. The place is quite small but definitely a gem. What is so unfortunate, the price is quite expensive. This might be due to the high quality ingredients used to create these stuffs.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "The food is so turkish! For the indonesians Turkish pastry might be overwhelmingly sweet, but for those who love sweet dessert, this place is a heaven. All the pastries are recommended, my most favorite one was pistachio classic baklava. If you love desert that has savoury ingredients, kunafe is a must. I also ordered the saffron ice cream but it turned out very weird, not recommended. The place is quite small but definitely a gem. What is so unfortunate, the price is quite expensive. This might be due to the high quality ingredients used to create these stuffs.",
        "languageCode": "en"
      },
      "authorAttribution": {
        "displayName": "Fauzan Illavi",
        "uri": "https://www.google.com/maps/contrib/117538680999780489804/reviews",
        "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjUSQzRvD223kiTPKOb0rzlz5HU6WBi19nVnksoPHHxUYzV-u_ov=s128-c0x00000000-cc-rp-mo-ba5"
      },
      "publishTime": "2020-03-01T16:11:20.327064Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VJQ0FnSURzMnBQYW1nRRAB&d=17924085&t=1&wv=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSURzMnBQYW1nRRAB!2m1!1s0x2e69f360d25b7c2b:0xf3fb1657b0a603c9"
