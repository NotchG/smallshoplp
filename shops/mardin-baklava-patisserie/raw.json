  "reviews": [
    {
      "name": "places/ChIJK3xb0mDzaS4RyQOmsFcW-_M/reviews/Ci9DQUlRQUNvZENodHljRjlvT2psRVpXSmFRbmRETjA5MmJUSXpkVlJVVUZKbVlrRRAB",
      "relativePublishTimeDescription": "a year ago",
      "rating": 5,
      "text": {
        "text": "Delicious Baklava with authentic taste. I like how the sweetness is tone down compare to the ones overseas. My fav is the chocolate pistachio baklava. It's not as sweet as compare to the other ones.\n\nThe kunafa was crunchy on the outside & cheesy on the inside, drizzle it w some syrup & it's so yummy.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "Delicious Baklava with authentic taste. I like how the sweetness is tone down compare to the ones overseas. My fav is the chocolate pistachio baklava. It's not as sweet as compare to the other ones.\n\nThe kunafa was crunchy on the outside & cheesy on the inside, drizzle it w some syrup & it's so yummy.",
        "languageCode": "en"
      },
