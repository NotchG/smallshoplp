    {
      "name": "places/ChIJK3xb0mDzaS4RyQOmsFcW-_M/reviews/ChZDSUhNMG9nS0VJQ0FnSURiMnJ2dVpnEAE",
      "relativePublishTimeDescription": "2 years ago",
      "rating": 5,
      "text": {
        "text": "One of the best baklava and khunafe in Jakarta. The baklava is sweet and tasty and the cheese khunafe is very cheesy and sweet with additional sugar syrup. I would recommend this restaurant if you like sweet, nutty, cheesy foods.\nThe service is great and the staff can explain in detail each food and beverage.\nThe place is very accomodating and comfortable (indoor room with an AC).",
        "languageCode": "en"
      },
      "originalText": {
        "text": "One of the best baklava and khunafe in Jakarta. The baklava is sweet and tasty and the cheese khunafe is very cheesy and sweet with additional sugar syrup. I would recommend this restaurant if you like sweet, nutty, cheesy foods.\nThe service is great and the staff can explain in detail each food and beverage.\nThe place is very accomodating and comfortable (indoor room with an AC).",
        "languageCode": "en"
      },
