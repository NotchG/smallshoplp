    {
      "name": "places/ChIJkaZqJO6TaS4RGa943dc7-zE/reviews/ChZDSUhNMG9nS0VJQ0FnSURsdU5hN0VREAE",
      "relativePublishTimeDescription": "2 years ago",
      "rating": 5,
      "text": {
        "text": "Love this earthy feeling coffeeshop!\nThe greenest one around eastern Jakarta, surrounded by kinda park kinda forest, with aesthetic building and corners.\nTried the matcha latte was good and ayam penyet with tofu & tempeh, the sambal chili is excellently tasty and kicking! 🌶️\nWill definitely come back!",
        "languageCode": "en"
      },
      "originalText": {
        "text": "Love this earthy feeling coffeeshop!\nThe greenest one around eastern Jakarta, surrounded by kinda park kinda forest, with aesthetic building and corners.\nTried the matcha latte was good and ayam penyet with tofu & tempeh, the sambal chili is excellently tasty and kicking! 🌶️\nWill definitely come back!",
        "languageCode": "en"
      },
