  "reviews": [
    {
      "name": "places/ChIJiZ1MydrtaS4RGKqdS36wk2A/reviews/Ci9DQUlRQUNvZENodHljRjlvT2s0dGJtY3lWbXBFY1djeWFYZ3lUWGhuUVRsWWFtYxAB",
      "relativePublishTimeDescription": "9 months ago",
      "rating": 5,
      "text": {
        "text": "makanan beragam: indo & western. ada menu anak2, small bites. pastry, dessert, aneka coffee/tea/milk based drinks.\npesanan saya: ayam afrika with nasi kebuli (rempah berasa) & gyudon andaliman.\nhonorable mention to kak surya (barista) saya pesan black basil, di-adjust espresso-nya jadi 15ml (base recipe) + 5ml + 7ml (27ml in total). if you like strong coffee, pls kindly ask the barista to add more espresso to this menu. the base recipe has sweet main taste, too overpowers the coffee taste. with some adjustments, finally i can taste the opposite: main arabica with sweet fruity secondary taste (from the strawberry syrup & grape juice added) & it still has after-taste strong coffee flavor in my palate",
        "languageCode": "en"
      },
      "originalText": {
        "text": "makanan beragam: indo & western. ada menu anak2, small bites. pastry, dessert, aneka coffee/tea/milk based drinks.\npesanan saya: ayam afrika with nasi kebuli (rempah berasa) & gyudon andaliman.\nhonorable mention to kak surya (barista) saya pesan black basil, di-adjust espresso-nya jadi 15ml (base recipe) + 5ml + 7ml (27ml in total). if you like strong coffee, pls kindly ask the barista to add more espresso to this menu. the base recipe has sweet main taste, too overpowers the coffee taste. with some adjustments, finally i can taste the opposite: main arabica with sweet fruity secondary taste (from the strawberry syrup & grape juice added) & it still has after-taste strong coffee flavor in my palate",
        "languageCode": "en"
      },
