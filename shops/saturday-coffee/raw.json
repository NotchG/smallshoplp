    {
      "name": "places/ChIJUXyCManzaS4RtinpvkHotlQ/reviews/ChZDSUhNMG9nS0VJQ0FnSUNyenREc053EAE",
      "relativePublishTimeDescription": "2 years ago",
      "rating": 5,
      "text": {
        "text": "A very nice small coffee shop near KCIC Halim. Offers a cozy indoor and outdoor space, suitable for work or killing time before boarding the train. I really love the Bangkok sauce french fries and the smoked beef risoles. Delicious with a decent portion, good value for money. For the coffee, I recommend the Wake Up Call (black coffee with lemon).",
        "languageCode": "en"
      },
      "originalText": {
        "text": "A very nice small coffee shop near KCIC Halim. Offers a cozy indoor and outdoor space, suitable for work or killing time before boarding the train. I really love the Bangkok sauce french fries and the smoked beef risoles. Delicious with a decent portion, good value for money. For the coffee, I recommend the Wake Up Call (black coffee with lemon).",
        "languageCode": "en"
      },
