    {
      "name": "places/ChIJZRhjMmvzaS4RrWuq19k_7Ik/reviews/ChZDSUhNMG9nS0VJQ0FnSUN4aHFQMVdBEAE",
      "relativePublishTimeDescription": "3 years ago",
      "rating": 4,
      "text": {
        "text": "My go-to beverage is the Americano. The barber service is quite good since I got the haircut I expected. To my surprise, they also have shoes cleaning services. As for the place, it is cozy enough. The only downside is that the place is quite hot.\n\nDespite that, still love the place.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "My go-to beverage is the Americano. The barber service is quite good since I got the haircut I expected. To my surprise, they also have shoes cleaning services. As for the place, it is cozy enough. The only downside is that the place is quite hot.\n\nDespite that, still love the place.",
        "languageCode": "en"
      },
