    {
      "name": "places/ChIJr8K9asvzaS4R19qBYn2g1i4/reviews/Ci9DQUlRQUNvZENodHljRjlvT25KWWNWZG5VMkpKVWxKemN6RXlkekJDY0V4b2RsRRAB",
      "relativePublishTimeDescription": "10 months ago",
      "rating": 5,
      "text": {
        "text": "This is a Japanese-style coffee shop in East Jakarta, inspired by Japan's stone gardens and traditional temple or shrine ornaments. We are particularly impressed with their coffee, which is truly exceptional. They offer a diverse selection of manual brew coffees, milk-based options, and other blends with unique flavors.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "This is a Japanese-style coffee shop in East Jakarta, inspired by Japan's stone gardens and traditional temple or shrine ornaments. We are particularly impressed with their coffee, which is truly exceptional. They offer a diverse selection of manual brew coffees, milk-based options, and other blends with unique flavors.",
        "languageCode": "en"
      },
