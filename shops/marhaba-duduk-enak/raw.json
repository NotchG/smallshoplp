      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xoWVZFSjNTVEpsU2tsVU1IWjJZWEZMYjJKYVJVRRAB!2m1!1s0x2e69f37d61d98fa7:0x463c68f40ee5a826"
