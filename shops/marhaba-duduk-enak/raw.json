  "reviews": [
    {
      "name": "places/ChIJp4_ZYX3zaS4RJqjlDvRoPEY/reviews/Ci9DQUlRQUNvZENodHljRjlvT2xoWVZFSjNTVEpsU2tsVU1IWjJZWEZMYjJKYVJVRRAB",
      "relativePublishTimeDescription": "8 months ago",
      "rating": 5,
      "text": {
        "text": "first time coming here for wfc. tried their Kopi Susu Kurma and Caesar Salad. the espresso based for the Kopi Susu wasn't too strong for me, but not that light. guess they used sukkari dates in it bc it was kinda too sweet for me, but since it was date so it was acceptable.\n\nhas mushala, the wudhu place for women is separated.\n\nI loved the ambience—had no issue with no music concept cafe, the staff who served my coffee and salad were friendly, and didn't need to wait too long for them to be served. would say it was pleasant to come here.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "first time coming here for wfc. tried their Kopi Susu Kurma and Caesar Salad. the espresso based for the Kopi Susu wasn't too strong for me, but not that light. guess they used sukkari dates in it bc it was kinda too sweet for me, but since it was date so it was acceptable.\n\nhas mushala, the wudhu place for women is separated.\n\nI loved the ambience—had no issue with no music concept cafe, the staff who served my coffee and salad were friendly, and didn't need to wait too long for them to be served. would say it was pleasant to come here.",
        "languageCode": "en"
      },
