      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21wbWFFVkpVa05EVVdSZlZXOVVTRWt6UjNod1kzYxAB!2m1!1s0x2e69ed407e3cd45f:0x7ccfa1e68ede4877"
