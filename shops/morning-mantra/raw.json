    {
      "name": "places/ChIJi4t5NBzzaS4RpqvvgD1NJmQ/reviews/Ci9DQUlRQUNvZENodHljRjlvT2xZMFRrVkdOM0oxYVhOU2FtNVpWbnBrVmt4NlMxRRAB",
      "relativePublishTimeDescription": "11 months ago",
      "rating": 5,
      "text": {
        "text": "A recommended place if you're looking a spot to work from cafe.  The internet speed is should be enough to finish your work (around 60-80 mbps, which is quite good). Good ambience, also it has a prayer room upstair. Overall a good experience and food were nice also.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "A recommended place if you're looking a spot to work from cafe.  The internet speed is should be enough to finish your work (around 60-80 mbps, which is quite good). Good ambience, also it has a prayer room upstair. Overall a good experience and food were nice also.",
        "languageCode": "en"
      },
