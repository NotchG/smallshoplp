    {
      "name": "places/ChIJV_HlqXnzaS4R9iWXOROVGNY/reviews/ChdDSUhNMG9nS0VJQ0FnSURnMll5QXFnRRAB",
      "relativePublishTimeDescription": "8 years ago",
      "rating": 5,
      "text": {
        "text": "This coffee shop has cozy and comfortable place for you to talk or discuss with your friend. It's not really crowded at the time I visited. My favorite coffee here is ice Vietnamese. I also happened to bought Kopi Enak, their signature coffee. It tastes unique yet delicious but still ice Vietnamese coffee is my favorite. Plus they have Wi-Fi for you if you want to work.",
        "languageCode": "en"
      },
      "originalText": {
