  "reviews": [
    {
      "name": "places/ChIJp7wM6dmLaS4RUixdISvxVLk/reviews/Ci9DQUlRQUNvZENodHljRjlvT2pBNVJEQnpjMWx6VWtGYVJtTTFlVUl0TTNsNlNXYxAB",
      "relativePublishTimeDescription": "4 months ago",
      "rating": 5,
      "text": {
        "text": "Accidentally went here when looking for a café in the area.\n\nThey have a decent atmosphere, I can imagine to chill and hang here.\n\nThey have wifi too, and I see people working here.\n\nTheir price is on average, not too high and not too low.\n\nThey misscarried my order with someone else, but in return they bring the correct order and even give an extra coffee as collateral. They don't sell any mineral water, but they allowed me to purchase it outside and bring it with me.\n\nBig respect for them 💪🏼\n\nOverall, I have a nice dining experience and would love to come back again anytime soon.\n\nVery recommended.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "Accidentally went here when looking for a café in the area.\n\nThey have a decent atmosphere, I can imagine to chill and hang here.\n\nThey have wifi too, and I see people working here.\n\nTheir price is on average, not too high and not too low.\n\nThey misscarried my order with someone else, but in return they bring the correct order and even give an extra coffee as collateral. They don't sell any mineral water, but they allowed me to purchase it outside and bring it with me.\n\nBig respect for them 💪🏼\n\nOverall, I have a nice dining experience and would love to come back again anytime soon.\n\nVery recommended.",
        "languageCode": "en"
      },
