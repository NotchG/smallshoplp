    },
    {
      "name": "places/ChIJS1vi9VqLaS4RaFDBGn2cK1k/reviews/ChZDSUhNMG9nS0VJQ0FnTURvemNYX1hnEAE",
      "relativePublishTimeDescription": "a year ago",
      "rating": 5,
      "text": {
        "text": "This cafe has a nice ambiance, delicious and affordable meals. There are lots of meals and drinks to choose from. The main course meals are incredibly delicious. The drinks are great. The pastry we usually order is the Choco Banana and the Tiramisu, it’s a must try! My children also love the Risoles and Sosis Solo. For my family and I, this place is a 10 out of 10 ❤️",
        "languageCode": "en"
      },
      "originalText": {
        "text": "This cafe has a nice ambiance, delicious and affordable meals. There are lots of meals and drinks to choose from. The main course meals are incredibly delicious. The drinks are great. The pastry we usually order is the Choco Banana and the Tiramisu, it’s a must try! My children also love the Risoles and Sosis Solo. For my family and I, this place is a 10 out of 10 ❤️",
        "languageCode": "en"
