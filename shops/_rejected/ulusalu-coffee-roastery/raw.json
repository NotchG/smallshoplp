  "reviews": [
    {
      "name": "places/ChIJS1vi9VqLaS4RaFDBGn2cK1k/reviews/ChZDSUhNMG9nS0VJQ0FnSUNaN0lmZkdBEAE",
      "relativePublishTimeDescription": "3 years ago",
      "rating": 4,
      "text": {
        "text": "It is strategically located in the food garden area of ​​the Jakarta Garden City housing complex.\n\nThe updated menu is in front of the cashier, yes, what is put on the table is the old menu and may not be available, yesterday I ordered hot tea according to the menu on the table but apparently they don't sell it anymore, there is only Twinnings brand premium tea.\n\nAnd the menu I ordered for spaghetti Oglio Olio turned out to be very spicy, it used chopped chilies and the cashier didn't inform me that the menu was spicy.\n\nFor the rest, the cafe atmosphere is quite cozy, there is no music and there are several tables with electric sockets.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "It is strategically located in the food garden area of ​​the Jakarta Garden City housing complex.\n\nThe updated menu is in front of the cashier, yes, what is put on the table is the old menu and may not be available, yesterday I ordered hot tea according to the menu on the table but apparently they don't sell it anymore, there is only Twinnings brand premium tea.\n\nAnd the menu I ordered for spaghetti Oglio Olio turned out to be very spicy, it used chopped chilies and the cashier didn't inform me that the menu was spicy.\n\nFor the rest, the cafe atmosphere is quite cozy, there is no music and there are several tables with electric sockets.",
        "languageCode": "en"
      },
      "authorAttribution": {
        "displayName": "Puspa Indah",
