  "reviews": [
    {
      "name": "places/ChIJGWNHZhbzaS4RBJb9lwZuDrA/reviews/ChdDSUhNMG9nS0VJQ0FnSUR6ejZlQ3pRRRAB",
      "relativePublishTimeDescription": "2 years ago",
      "rating": 5,
      "text": {
        "text": "Agan Coffee offers a cozy spot for coffee aficionados, with an inviting ambiance perfect for catching up with friends or tackling some work. The affordable prices make it a go-to spot, although the narrow parking lots can be a bit of a hassle. However, once you're inside, the delicious coffee and tasty meals make up for any parking woes. They offer a variety of payment methods, which is convenient, and there are plenty of sockets available for powering up your devices. Whether you're looking for a quick caffeine fix or a place to settle in for a while, Agan Coffee has you covered.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "Agan Coffee offers a cozy spot for coffee aficionados, with an inviting ambiance perfect for catching up with friends or tackling some work. The affordable prices make it a go-to spot, although the narrow parking lots can be a bit of a hassle. However, once you're inside, the delicious coffee and tasty meals make up for any parking woes. They offer a variety of payment methods, which is convenient, and there are plenty of sockets available for powering up your devices. Whether you're looking for a quick caffeine fix or a place to settle in for a while, Agan Coffee has you covered.",
        "languageCode": "en"
      },
