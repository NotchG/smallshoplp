  "reviews": [
    {
      "name": "places/ChIJnQVpeCSNaS4RgU77ArFOpdw/reviews/Ci9DQUlRQUNvZENodHljRjlvT21ka2NXbGpjR2RZVFc1TVJHSlFhMWxuWVc1M09WRRAB",
      "relativePublishTimeDescription": "6 months ago",
      "rating": 5,
      "text": {
        "text": "The place is cozy and spacious, with several floors to choose from. I booked the VIP room, which requires a minimum order of 1 million IDR, and it comes with live music, definitely worth it.\n\nIt’s a great spot for hanging out with friends or even for family gatherings. The food tastes good, and their signature coffee is really outstanding.\n\nOverall, a comfortable place with good vibes and great coffee.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "The place is cozy and spacious, with several floors to choose from. I booked the VIP room, which requires a minimum order of 1 million IDR, and it comes with live music, definitely worth it.\n\nIt’s a great spot for hanging out with friends or even for family gatherings. The food tastes good, and their signature coffee is really outstanding.\n\nOverall, a comfortable place with good vibes and great coffee.",
        "languageCode": "en"
      },
