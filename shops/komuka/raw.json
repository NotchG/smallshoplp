  "reviews": [
    {
      "name": "places/ChIJ8eYMJtiLaS4RpOiKeaXUJGc/reviews/Ci9DQUlRQUNvZENodHljRjlvT2paMVp6a3RSVXBzZW5OV1VtMU9lazVaYjBwd1MwRRAB",
      "relativePublishTimeDescription": "4 months ago",
      "rating": 4,
      "text": {
        "text": "They're easy to find, located on the hook.\n\nThey offer more than just coffee, they have tea, and even full-course meal.\n\nThey do have a nice atmosphere that I can't put into word. You'll have to try it yourself. If you need a space to yourself, this one might be your place. You can work or even enjoy reading a book here.\n\nThey just updated their menu last month, i provide some of them here.\n\nRecommended, and might come back again in the near future.",
        "languageCode": "en"
      },
      "originalText": {
