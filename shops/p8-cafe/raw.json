      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2paVlExSlpUbkpwWW5jMFlWWmhVbEZPYlVZeFJIYxAB!2m1!1s0x2e69f554bc682211:0x2f6bededd49a3ee6"
