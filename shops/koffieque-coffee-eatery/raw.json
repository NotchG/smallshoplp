  "reviews": [
    {
      "name": "places/ChIJD7EJitKNaS4RVT12jP_HjpY/reviews/Ci9DQUlRQUNvZENodHljRjlvT21FNU1XNUpjVEE0Wm1vM1RWZExORkJ6UVhScFEwRRAB",
      "relativePublishTimeDescription": "a year ago",
      "rating": 5,
      "text": {
        "text": "I enjoyed my time here. The place is easy to pop into, quite comfy and clean with decent facilities (clean toilet and a small mushala that fits for 2-3 person). The menus is quite various from Western to Indonesian, the portion is adequate. Their coffee is good and varies with pretty reasonable price for the area. KoffieQue is such an instant go-to place on my way to work!",
        "languageCode": "en"
      },
      "originalText": {
